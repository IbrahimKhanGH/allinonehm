# ---------------------------------------------------------------------------
# Quote-form email delivery (Resend — free tier). Copy this file to .env.local
# for local dev, and add the same vars in your Vercel project settings.
# ---------------------------------------------------------------------------

# Required. From https://resend.com → API Keys.
# Tip: sign up for Resend using management@allinonehm.com so the default shared
# sender below can deliver to it with NO domain verification needed.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Optional. Where quote submissions are delivered.
QUOTE_TO_EMAIL=management@allinonehm.com

# Optional. The "from" address. Leave as the shared sender until you verify the
# allinonehm.com domain in Resend; after that you can use your own address,
# e.g. "All In One Home Management <quotes@allinonehm.com>".
QUOTE_FROM_EMAIL=All In One Home Management <onboarding@resend.dev>
